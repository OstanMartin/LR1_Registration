<Window x:Class="bebebe.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bebebe"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="Journal" Height="900" Width="1600" UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Icon="/Images/JournalIcon.png"
        >
    <Grid>
        <Image x:Name="BackgroundImage" HorizontalAlignment="Left" Height="960" Margin="0,0,0,0" VerticalAlignment="Top" Width="1140" Source="/Images/LoginScreenBackground.jpg" Stretch="UniformToFill"/>
        <Image x:Name="JournalIcon" Source="/Images/JournalIcon.png" Width="50" Height="50" Margin="860, -685, 0, 0"/>

        <TextBlock Text="Journal" FontWeight="Medium" FontFamily="SF Pro" FontSize="21px" Foreground="DarkSlateGray"
                   Width="100" Height="25" Margin="1010, -695, 0, 0"/>
        <TextBlock Text="Nice to see you again" FontWeight="Bold" FontSize="18px" Foreground="DarkSlateGray"
                   Height="50" Width="250" Margin="1068, -500, 0, 0"/>

        <Label Content="Login" FontSize="12" Foreground="SlateGray"
               Height="50" Width="50" Margin="880, -405, 0, 0"/>
        <Border x:Name="LoginBorder" Visibility="Visible"
                BorderThickness="2" BorderBrush="WhiteSmoke" Background="WhiteSmoke" CornerRadius="8" Padding="2" 
                Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,236,48,0" SnapsToDevicePixels="True">
            <TextBox x:Name="Login" Visibility="Visible"
                     FontSize="16" FontStretch="Medium" Foreground="DarkSlateGray" 
                     Background="Transparent"
                     VerticalContentAlignment="Center" VerticalAlignment="Stretch" BorderThickness="0"  HorizontalAlignment="Stretch" UseLayoutRounding="True" Margin="7, -2, 0, 0"/>
        </Border>

        <Label Content="Password"  FontSize="12" Foreground="SlateGray"
               Height="50" Width="100" Margin="930, -235, 0, 0"/>
        <Border x:Name="PasswordBorder" Visibility="Visible"
                BorderThickness="2" BorderBrush="WhiteSmoke" Background="WhiteSmoke" CornerRadius="8" Padding="2" 
                Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,320,48,0" SnapsToDevicePixels="True">
            <PasswordBox Visibility="Visible" x:Name="Password" 
                         BorderThickness="0" Background="Transparent"
                         FontSize="16" FontStretch="Medium" Foreground="DarkSlateGray" 
                         VerticalContentAlignment="Center" VerticalAlignment="Stretch"  HorizontalAlignment="Stretch" UseLayoutRounding="True" Margin="7, -2, 0, 0"/>
        </Border>

        <Border x:Name="PTBBorder" Visibility="Visible"
                BorderThickness="0"
                Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,320,48,0" SnapsToDevicePixels="True">
            <TextBox x:Name="PasswordTextBox" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0"
                     FontSize="18" FontStretch="Medium" Foreground="DarkSlateGray"
                     VerticalContentAlignment="Center" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="342" Height="40" Margin="10,-2,0,0"/>
        </Border>
        <Button x:Name="SeePasswordButton" 
                Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0, 0, 70, 180" 
                Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" 
                Click="SPButtonClicked">
            <Image Source="/Images/eyeOpen.png"/>
        </Button>
        <Button x:Name="HidePasswordButton"
                Click="HPButtonClicked" 
                Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0, 0, 70, 180" 
                Background="Transparent" BorderThickness="0" 
                FocusVisualStyle="{x:Null}"
                Visibility="Collapsed">
            <Image Source="/Images/eyeClosed.png"/>
        </Button>

        <Button x:Name="PasswordRecoveryRedirectButton" 
                Height="30" Width="120" 
                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,50,85" 
                BorderThickness="0" Background="Transparent"
                FocusVisualStyle="{x:Null}"
                >
            <Label x:Name="PasswordRecoveryButton"
                   Content="Forgot password?" FontSize="12" FontStretch="ExtraExpanded" Foreground="DarkSlateGray" Style="{DynamicResource DarkLoginLabelStyle}"/>
        </Button>

        <CheckBox
            x:Name="RememberMeCheckbox"
            Content="Remember me" FontSize="12" Foreground="DarkSlateGray" 
            Width="100" Height="20" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,280,80"
            IsChecked="false"
            FocusVisualStyle="{x:Null}"
            />
        <Border x:Name="SignInBorder" Visibility="Visible"
                BorderThickness="2" BorderBrush="Transparent" Background="DarkSlateGray" CornerRadius="8" Padding="2" 
                Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,430,48,0" SnapsToDevicePixels="True">
            <Button
                x:Name="SignInButton" 
                Background="Transparent" BorderThickness="0"
                FontSize="18" FontStretch="Medium" Foreground="WhiteSmoke" FontFamily="SemiBold"
                Content="Sign In"
                Width="342" Height="40" Margin="-4"/>
        </Border>

        <Separator x:Name="SeparatorLogin"
            Background="#e1e3e1"
            Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,475,48,0" SnapsToDevicePixels="True"/>
        <Label 
            Background="White" Foreground="#e1e3e1"
            Content="Or"
            Width="30" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,475,198,0"
            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>


        <Border x:Name="SignUpBorder" Visibility="Visible"
                BorderThickness="2" BorderBrush="DarkSlateGray" Background="Transparent" CornerRadius="8" Padding="2" 
                Width="342" Height="40" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,522,48,0" SnapsToDevicePixels="True">
            <Button
                x:Name="SignUpButton" 
                Background="Transparent" BorderThickness="0"
                FontSize="18" FontStretch="Medium" Foreground="DarkSlateGray" FontFamily="SemiBold"
                Content="Sign Up"
                Width="342" Height="40" Margin="-4"/>
        </Border>
    </Grid>
</Window>
